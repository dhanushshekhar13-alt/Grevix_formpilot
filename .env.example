# Local inference only. No API keys needed.
OLLAMA_BASE_URL=http://localhost:11434
FORMPILOT_MODEL=qwen3-vl:4b-instruct
FORMPILOT_MAX_STEPS=60
FORMPILOT_ACTION_TIMEOUT=10
# Per model call (first call loads the model into memory and can be slow)
FORMPILOT_REQUEST_TIMEOUT=120
FORMPILOT_MODEL_RETRIES=2
# norm1000 = Qwen3-VL 0..1000 grid (default for qwen3-vl). Use "pixels" for other models.
# FORMPILOT_COORD_MODE=norm1000
FORMPILOT_HEADED=0
# Set 0 to disable screen recording (frames are still saved)
FORMPILOT_RECORD_VIDEO=1
